<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center_horizontal"
    android:padding="35dp"
    android:background="#F8F8F4">

    <!-- שם האפליקציה -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="READYFIT"
        android:textSize="42sp"
        android:textStyle="bold"
        android:textColor="#556B2F"
        android:layout_marginTop="90dp"
        android:layout_marginBottom="10dp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="מערכת אימונים חכמה לכושר קרבי"
        android:textSize="16sp"
        android:textColor="#666666"
        android:layout_marginBottom="50dp"/>


    <!-- אימייל -->
    <EditText
        android:id="@+id/editEmail"
        android:layout_width="match_parent"
        android:layout_height="55dp"
        android:hint="שם משתמש / אימייל"
        android:inputType="textEmailAddress"
        android:padding="12dp"
        android:backgroundTint="#556B2F"
        android:layout_marginBottom="20dp"/>


    <!-- סיסמה -->
    <EditText
        android:id="@+id/editPassword"
        android:layout_width="match_parent"
        android:layout_height="55dp"
        android:hint="סיסמה"
        android:inputType="textPassword"
        android:padding="12dp"
        android:backgroundTint="#556B2F"
        android:layout_marginBottom="30dp"/>


    <!-- התחברות -->
    <Button
        android:id="@+id/btnLogin"
        android:layout_width="match_parent"
        android:layout_height="58dp"
        android:text="התחברות"
        android:textSize="18sp"
        android:textColor="#FFFFFF"
        android:backgroundTint="#556B2F"/>


    <!-- אין חשבון -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="אין לך חשבון?"
        android:textSize="15sp"
        android:textColor="#555555"
        android:layout_marginTop="30dp"/>


    <!-- פתיחת חלונית הרשמה -->
    <Button
        android:id="@+id/btnOpenRegister"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="לחץ כאן להרשמה"
        android:textSize="15sp"
        android:textColor="#556B2F"
        android:backgroundTint="#F8F8F4"/>

</LinearLayout>